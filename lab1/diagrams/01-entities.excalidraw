   "text": "CHECK seated -> row, seat\nCHECK box -> bundle_id, seat\nCHECK ga -> slot\nCHECK free <-> нет order_id\nUNIQUE (sector_id, row, seat)\nUNIQUE (bundle_id, seat)\nUNIQUE (sector_id, slot)\nUNIQUE order_items (ticket_id)\n  WHERE active\nINDEX (sector_id) WHERE free\nFK (sector_id, kind, event_id)",
   "originalText": "CHECK seated -> row, seat\nCHECK box -> bundle_id, seat\nCHECK ga -> slot\nCHECK free <-> нет order_id\nUNIQUE (sector_id, row, seat)\nUNIQUE (bundle_id, seat)\nUNIQUE (sector_id, slot)\nUNIQUE order_items (ticket_id)\n  WHERE active\nINDEX (sector_id) WHERE free\nFK (sector_id, kind, event_id)",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
